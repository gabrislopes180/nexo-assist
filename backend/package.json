{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/db/test-environment.ts --test \"src/**/*.test.ts\"",
    "eval:agent": "tsx --env-file=.env src/agent/decisions.real.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx src/db/local-command.ts migrate dev",
    "db:deploy": "tsx src/db/local-command.ts migrate deploy",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:deploy && npm run db:generate && npm run db:seed",
    "db:reset": "tsx src/db/local-command.ts migrate reset --force && npm run db:generate && npm run db:seed",
    "db:studio": "tsx src/db/local-command.ts studio",
    "db:turso:inspect": "tsx src/db/turso-command.ts inspect",
    "db:turso:migrate": "tsx src/db/turso-command.ts migrate",
    "db:turso:init": "tsx src/db/turso-command.ts init",
    "db:turso:smoke": "tsx src/db/turso-command.ts smoke"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.81.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
