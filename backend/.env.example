DATABASE_URL="file:./dev.db"
# Para Turso, substitua DATABASE_URL por libsql://SEU-BANCO.turso.io e preencha o token.
# Não coloque tokens na URL; SQLite file: não precisa de token. Não altere por NODE_ENV.
TURSO_AUTH_TOKEN=""

# Segredo que assina o cookie de sessão (mínimo de 32 caracteres; troque em produção)
SESSION_SECRET="dev-only-troque-em-producao-0123456789abcdef"
# Origens exatas do frontend, separadas por vírgula (sem * e sem barra final)
CORS_ORIGINS="http://localhost:3000"

# Chave do Google AI Studio usada pelo agent (obtenha em https://aistudio.google.com/apikey)
LLM_API_KEY=""
# Modelo do agent no formato provider/modelo (opcional; este é o padrão)
AGENT_MODEL="google/gemini-3.5-flash-lite"
# Limite do turno inteiro do agent, em milissegundos (opcional; este é o padrão)
AGENT_TIMEOUT_MS="120000"
# Na Render com proxy Vercel, use 100000 (o limite externo é 120 s).
# off = normal; down = simula o serviço de chamados fora do ar (recusado em produção)
TICKET_SERVICE_SIMULATION="off"
