# URL do backend, sem barra final. O navegador só fala com o Next; as chamadas a
# /api/* são reescritas para este destino. Obrigatória em build de produção.
API_PROXY_TARGET=http://localhost:8000
# Na Vercel, substituir pela URL HTTPS real da API Render e fazer novo deploy.
# DATABASE_URL e TURSO_AUTH_TOKEN pertencem apenas ao backend.
