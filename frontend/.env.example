# URL do backend, sem barra final. O navegador só fala com o Next; as chamadas a
# /api/* são reescritas para este destino. Obrigatória em build de produção.
API_PROXY_TARGET=http://localhost:8000

# Console do analista: mock (padrão) ou real. Use real quando o backend expuser /console.
NEXT_PUBLIC_CONSOLE_API=mock
